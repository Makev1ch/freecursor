{
  "schemaVersion": 1,
  "id": "freecursor",
  "version": "${version}",
  "name": "FreeCursor",
  "description": "A mod for freeing the cursor by pressing a configured key. Allows you to release the mouse cursor and return it back to the game.",
  "authors": [
    "Makev1ch",
    "Igr0man1y3_2"
  ],
  "contact": {
    "homepage": "https://github.com/Makev1ch/freecursor",
    "sources": "https://github.com/Makev1ch/freecursor",
    "issues": "https://github.com/Makev1ch/freecursor/issues"
  },
  "license": "GPL-2.0-only",
  "icon": "assets/freecursor/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.makev1ch.freecursor.FreeCursor"
    ],
    "client": [
      "com.makev1ch.freecursor.FreeCursorClient"
    ],
    "modmenu": [
      "com.makev1ch.freecursor.FreeCursorModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
